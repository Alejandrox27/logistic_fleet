# ── Credenciales de la base de datos ─────────────────────────
# Copia este archivo a ".env" y cambia los valores si quieres.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).

# Contraseña del usuario root de MySQL (uso interno de Docker)
MYSQL_ROOT_PASSWORD=rootsecret

# Nombre de la base de datos
MYSQL_DATABASE=logistics_fleet_db

# Usuario y contraseña para la aplicación
MYSQL_USER=logistics_user
MYSQL_PASSWORD=logistics123
